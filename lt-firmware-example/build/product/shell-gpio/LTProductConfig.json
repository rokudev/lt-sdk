//
// The shell product plus a "gpio" command that exercises LTDeviceGpio.  The
// platform's LTDeviceConfig.json has to declare an LTDeviceGpio device for the
// command to have anything to talk to.
//
{"config":{"product":{"genesis":{ "lib":  "LTSystemShell" },
                        "build":{"libs":[
                                         "LTUtilityByteOps",
                                         "LTSystemSettings",
                                         "ShellGpio"
                                        ]
                        }
}         }          }
