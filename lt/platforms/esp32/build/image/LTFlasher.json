// NOTE: No flasher stub image below has been modified from its original
// version.
//
//   esp32   - as originally imported into this SDK.
//   esp32s3 - esptool v4.7.0, esptool/targets/stub_flasher/stub_flasher_32s3.json.
//   esp32c3 - ESP32C3ROM.STUB_CODE from the esptool.py 3.2-dev already vendored at
//             source/esp32/mastering/image/esptool.py, which embeds the stub inline
//             rather than as a standalone JSON file.
//
// One entry per chip, selected by name at flash time: rit passes the name it read
// out of the part it found on the wire, so a variant only ever loads its own stub.
//
// image_b is the esptool stub flattened into the section layout that rit's
// Esp32LoadAndRunFlasher() walks. Use mkltflasher.py in this directory to convert
// a new stub, or to decode one already present here.
{
  flasher: {
    esp32: {
        image_b: ""
    },
    esp32s3: {
        image_b: ""
    },
    esp32c3: {
        image_b: ""
    }
  }
}
