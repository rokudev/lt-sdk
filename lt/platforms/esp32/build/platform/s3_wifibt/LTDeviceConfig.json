//
// Minimal device set for the s3 variant, mirroring the "minimal" variant.
// The drivers are the S3 specific ones; the esp32 versions are pinned to the
// esp32 register set and headers and cannot serve this chip.
//
{
  "config":{
        "net":{ "transport": [ { "lib": "LTDriverNetTransportLwipWiFi" } ] },
     "device":[ { "lib": "LTDeviceBle",           "driver": [ { "lib": "CommonDriverBleNimble"       } ] },
                { "lib": "LTDeviceBleController", "driver": [ { "lib": "Esp32s3DriverBleController"  } ] },
                { "lib": "LTDeviceCrypto",        "driver": [ { "lib": "Esp32s3DriverCrypto"         } ] },
                { "lib": "LTDeviceFlash",         "driver": [ { "lib": "Esp32s3DriverFlash"          } ] },
                { "lib": "LTDeviceWatchdog",      "driver": [ { "lib": "Esp32s3DriverWatchdog"       } ] },
                { "lib": "LTDeviceWiFi",          "driver": [ { "lib": "Esp32s3DriverWiFi"           } ] }
              ]
           },
 "extra-libs":[ "LTThirdPartyLWIP",
                "Esp32s3ThirdPartyWPASupplicant",
                "Esp32_LTOSAdapter"
              ],

    "memory":{ "regions":[ { "name": "psram", "region": 4 } ] }
}
