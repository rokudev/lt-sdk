#
# ESP32-S3 (Xtensa LX7) variant of the esp32 platform root.
#
# The two parts share the LT sources and the vendored IDF code that is written to
# compile for either, and share nothing below that: the esp32s3 replaced DPORT with
# SYSTEM, relocated every peripheral and renumbered the interrupt sources.  So the
# root keys everything that differs by $(SOC_PLATFORM_NAME), set below, and this
# variant reaches its own copy of each.  Hand written for the part, with nothing in
# IDF to vendor:
#
#   include/esp32s3/Esp32_*.h                    register map, interrupt mux,
#                                                clocks, cache, GPIO, SoC, watchdog
#   source/esp32/ltcorebsp/esp32s3/              Esp32_Cache.c, Esp32_Clock.c,
#                                                Esp32_Console.c, Esp32_GPIO.c,
#                                                Esp32_PSRAM.c, Esp32_LTCoreBSP.c,
#                                                Esp32_LTChipStart.c
#   source/esp32/mastering/ld/esp32s3/           memory.ld and sections.ld
#
# Vendored from Espressif for the part:
#
#   source/esp32/ltbootloader/esp32s3/           chip specific bootloader sources
#   source/esp32/ltbootloader/include/esp32s3/   register/ROM/HAL header tree
#   source/esp32/ltbootloader/ld/esp32s3/        bootloader.ld, bootloader.rom.ld,
#                                                esp32s3.peripherals.ld, rom/*.ld
#
# Everything vendored comes from ESP-IDF release/v4.4.  Note that the tree is
# forked from a v4.4 pre-release (commit 4c0cf40a, June 2021), not from v4.4.8, so
# the esp32s3 files are taken from whichever of the two matches the shared code
# they link against - see the note in Esp32_LTBootloader.mk.
#
# The radio drivers exist for this part - Esp32s3DriverWiFi,
# Esp32s3DriverBleController and Esp32s3DriverCrypto sit alongside the esp32 ones
# under source/esp32/driver - and wpa_supplicant, which IDF ships as source rather
# than as a blob, is built from that source by Esp32s3ThirdPartyWPASupplicant.
# Esp32_LTOSAdapter now compiles against the esp32s3 sdkconfig, so the
# coex_adapter_funcs_t and wifi_osi_funcs_t tables take their esp32s3 shape, and
# Esp32s3_LTOSAdapter.c supplies the per chip registers plus the ets_timer entry
# points the supplicant arms its timers with, which this ROM does not export.
#
# The Espressif blobs for the part are in place under
# source/esp32/mastering/lib/esp32s3, and LT_PLATFORM_HAS_WIRELESS_BLOBS below is on.
# libpp, libnet80211, libcore, libphy, libcoexist, libbtdm_app, libbtbb, libespnow
# and libsmartconfig all link into the image; libmesh and libwapi ship alongside
# them but nothing here pulls them in.
#
# The radio interrupt lines are allocated in include/esp32s3/Esp32_Irq.h.  Where the
# esp32 had fixed assignments, this part maps any peripheral source onto any CPU
# line, and the blobs pick their own numbers at runtime - the Wi-Fi MAC asks for
# line 0, and the BLE controller's r_intc_init asks for RWBLE on 5 and BT baseband
# on 8.  So the adapter and the BLE driver check the number they are handed against
# the assignable set rather than dictating it, and the table in Esp32_Irq.h records
# who owns what so that a later assignment cannot land on one of them.
#
# One known gap against the prebuilt esp32 archive: no WPA3-SAE.  IDF supplies
# crypto_bignum_* and crypto_ec_* only from its mbedTLS shims, and LTSystemCrypto
# is ECDSA-P256 only, so the source built supplicant is WPA2 max here.  LT does
# carry mbedTLS 3.4.0 under lt/source/lt/net/dtls/mbedtls with the curve and
# bignum modules on, so the route exists - it needs IDF's two shim files ported
# across the mbedTLS 2.28 to 3.4 API drift.

# 1. set platform specific build parameters for enacted build
#            a.  ltk architecture ident, has runtime loader status, bsp and mastering project ident,
#            b.  platform only vendor sdk defs, e.g. include paths for platform projects
#            c.  optional update to global CFLAGS with cross-compiler specific CFLAGS to use globally
SOC_PLATFORM_NAME                       := esp32s3
LT_LTKERNEL_ARCHITECTURE                := LT_LTKERNEL_ARCHITECTURE_XTENSA
LT_PLATFORM_HAS_RUNTIME_DYNAMIC_LOADER  := no
LT_NULLIFY_ALL_NON_SERVER_LTLOGS        := no
LT_NULLIFY_ALL_LT_ASSERTS               := no

LT_PLATFORM_LTCOREBSP_PROJECT           := Esp32_LTCoreBSP
LT_PLATFORM_MASTERING_PROJECTS          := Esp32_MasterFirmwareImage
LT_PLATFORM_PROJECT_ONLY_DEFS           += -I$(LT_PLATFORM_PUBLIC_INCLUDE_DIR)/$(SOC_PLATFORM_NAME)

# The Espressif blobs for this part live in source/esp32/mastering/lib/esp32s3.
LT_PLATFORM_HAS_WIRELESS_BLOBS          := yes

# Board facts, overriding the wroom32-shaped defaults the shared project files
# carry.  Both are board rather than chip properties, which is why they live here
# and not under an $(SOC_PLATFORM_NAME) test in the project files: another esp32s3
# board could differ on either.
#
# The image is mastered as 16MB.  The development board carries 32MB, but esptool
# only stamps a size for the ROM loader to sanity check against, and 16MB is the
# largest it accepts for this part.
ESP32_IMAGE_FLASH_SIZE                  := 16MB

# The part talks to the host over its own USB serial/JTAG peripheral, so it
# enumerates as a CDC device rather than arriving through a UART bridge.
LT_FLASH_DEVICE                         ?= /dev/ttyACM0

LT_CFLAGS_DEBUG                         += -gdwarf-3
LT_CFLAGS_GENERIC                       += -ffreestanding -fno-jump-tables -fdiagnostics-color=auto -mlongcalls -Wno-undef
LT_CFLAGS_GENERIC                       += -DLT_TEXT_RAM_CRITICAL_THRESHOLD=0 -DLT_RODATA_RAM_CRITICAL_THRESHOLD=0

LT_CXXFLAGS_GENERIC                       += -ffreestanding -fno-jump-tables -fdiagnostics-color=auto -mlongcalls -Wno-undef
LT_CXXFLAGS_GENERIC                       += -DLT_TEXT_RAM_CRITICAL_THRESHOLD=0 -DLT_RODATA_RAM_CRITICAL_THRESHOLD=0

#                                       TODO: add named SRAM segmengs to linker definitions file and change these THRESHOLDS accordingly

######
# step 2 - setup toolchain variables
# TOOLCHAIN IDENTIFICATION
# a. Identifying the location:
#    Either:
#      LT_GCC_TOOLCHAIN_PATH    - the absolute path to the bin directory for the toolchain binaries
#    Or:
#      LT_TOOLCHAIN_SERVER      - <gitlab | github> - the server type from which to fetch the toolchain tarball
#      LT_TOOLCHAIN_REPO        - the repo from which to fetch the toolchain tarball
#      LT_TOOLCHAIN_TARFILE     - the name of the toolchain tarball file to fetch from the repo
#      LT_TOOLCHAIN_DIRNAME     - the name of the top level directory extracted from the toolchain tarball, e.g. if riscv64-bl70x-elf, toolchain bin dir would be: riscv64-bl70x-elf/bin
#                               - note: if LT_TOOLCHAIN_DIRNAME not specified, taken from basename of LT_TOOLCHAIN_TARFILE
# b. Identifying the prefix:
#      LT_GCC_TOOLCHAIN_PREFIX  - the prefix of toolchain binaries, e.g. "riscv64-unknown-elf" for riscv64-unknown-elf-gcc, riscv64-unknown-elf-nm, etc.
LT_TOOLCHAIN_SERVER         := github
LT_TOOLCHAIN_REPO           := rokudev/lt-toolchains

ifeq ($(LT_TOOLCHAIN_HOST_OS_NAME), Darwin)
    # MAC
    ifeq ($(LT_TOOLCHAIN_HOST_ARCHITECTURE), arm64)
        LT_TOOLCHAIN_TARFILE ?= xtensa-esp32s3-elf-gcc11_2_0-esp-2022r1-macos-arm64.txz
    else
        LT_TOOLCHAIN_TARFILE ?= xtensa-esp32s3-elf-gcc11_2_0-esp-2022r1-macos.txz
    endif
else
    # NOT MAC
    ifeq ($(LT_TOOLCHAIN_HOST_ARCHITECTURE), x86_64)
        LT_TOOLCHAIN_TARFILE ?= xtensa-esp32s3-elf-gcc11_2_0-esp-2022r1-linux-amd64.tar.xz
        LT_TOOLCHAIN_DIRNAME := xtensa-esp32s3-elf
    endif
    ifeq ($(LT_TOOLCHAIN_HOST_ARCHITECTURE), aarch64)
        LT_TOOLCHAIN_TARFILE ?= xtensa-esp32s3-elf-gcc11_2_0-esp-2022r1-linux-arm64.tgz
    endif
    LT_TOOLCHAIN_TARFILE ?= xtensa-esp32s3-elf-gcc11_2_0-esp-2022r1-linux-i686.tgz
endif

LT_GCC_TOOLCHAIN_PREFIX     := xtensa-esp32s3-elf

