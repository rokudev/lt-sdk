#
# ESP32-P4 (RISC-V RV32IMAFC) variant of the esp32 platform root.
#
# The second RISC-V variant here, and the first with hard float and a CLIC.  It
# follows the c3 in leaving out the Xtensa-only compiler and link flags, and
# differs from it in three ways that reach the whole build:
#
#   - hard float.  -mabi=ilp32f changes the calling convention, so every object
#     in the image including libgcc has to agree; the toolchain's rv32imafc/ilp32f
#     multilib supplies the matching libgcc.
#   - a CLIC rather than an interrupt matrix, so the BSP programs mtvec for
#     CLIC-vectored mode.  See source/esp32/ltcorebsp/esp32p4/Esp32_Interrupt.c.
#   - the ROM loads the second stage bootloader from byte 0x2000, not 0x0 as on
#     the c3 and s3 or 0x1000 as on the esp32.  LTFlashConfig.json reflects that.
#
# The root keys everything chip specific by $(SOC_PLATFORM_NAME), set below, and
# this variant reaches its own copy of each.  Hand written for the part:
#
#   include/esp32p4/Esp32_*.h                    register map, CLIC, clocks,
#                                                cache, GPIO, SoC, watchdog
#   source/esp32/ltcorebsp/esp32p4/              Esp32_Cache.c, Esp32_Clock.c,
#                                                Esp32_Console.c, Esp32_GPIO.c,
#                                                Esp32_Interrupt.c, Esp32_LTCoreBSP.c,
#                                                Esp32_LTChipStart.c
#   source/esp32/mastering/ld/esp32p4/           memory.ld and sections.ld
#
# Vendored from Espressif for the part:
#
#   source/esp32/ltbootloader/esp32p4/           chip specific bootloader sources
#   source/esp32/ltbootloader/include/esp32p4/   register/ROM/HAL header tree
#   source/esp32/ltbootloader/ld/esp32p4/        bootloader.ld, bootloader.rom.ld,
#                                                esp32p4.peripherals.ld, rom/*.ld
#
# Everything vendored for this chip comes from ESP-IDF v5.4, which is the first
# release to carry the part; the esp32/esp32s3/esp32c3 trees stay on v4.4.x.
# Mixing IDF vintages per file is established practice here - see the note in
# build/project/Esp32_LTBootloader.mk.  bootloader_esp32p4.c is the exception:
# upstream's version is written against a HAL layer this tree does not have, so
# it is hand written in the shape of bootloader_esp32c3.c, calling the P4 ROM's
# own Cache_* entry points where upstream calls cache_hal_init()/mmu_hal_init().
#
# Developed against a Waveshare ESP32-P4-Nano: ESP32-P4NRW32, 16MB of external
# NOR flash, 32MB of in-package PSRAM, and a CH343 USB-to-UART bridge on the
# Type-C connector.  Unlike the c3 there is no native USB serial/JTAG peripheral
# in the console path, so the console is UART0 on GPIO37/38.
#
# The PSRAM is not brought up by this variant - there is no Esp32_PSRAM.c for the
# part and LTDeviceConfig.json declares no memory region - so the image runs out
# of internal SRAM only.
#
# The board's WiFi/BT comes from a companion ESP32-C6-MINI over SDIO rather than
# from a radio inside the P4, and there are no drivers for it in this tree, so
# LT_PLATFORM_HAS_WIRELESS_BLOBS is off and LTDeviceConfig.json carries Flash,
# Watchdog and GPIO only.

# 1. set platform specific build parameters for enacted build
#            a.  ltk architecture ident, has runtime loader status, bsp and mastering project ident,
#            b.  platform only vendor sdk defs, e.g. include paths for platform projects
#            c.  optional update to global CFLAGS with cross-compiler specific CFLAGS to use globally
SOC_PLATFORM_NAME                       := esp32p4
LT_LTKERNEL_ARCHITECTURE                := LT_LTKERNEL_ARCHITECTURE_RISC_V
LT_PLATFORM_HAS_RUNTIME_DYNAMIC_LOADER  := no
LT_NULLIFY_ALL_NON_SERVER_LTLOGS        := no
LT_NULLIFY_ALL_LT_ASSERTS               := no

LT_PLATFORM_LTCOREBSP_PROJECT           := Esp32_LTCoreBSP
LT_PLATFORM_MASTERING_PROJECTS          := Esp32_MasterFirmwareImage
LT_PLATFORM_PROJECT_ONLY_DEFS           += -I$(LT_PLATFORM_PUBLIC_INCLUDE_DIR)/$(SOC_PLATFORM_NAME)

# No radio devices on this variant - see the note above.
LT_PLATFORM_HAS_WIRELESS_BLOBS          := no

# Board facts, overriding the wroom32-shaped defaults the shared project files
# carry.  The Nano carries 16MB of external NOR flash.
ESP32_IMAGE_FLASH_SIZE                  := 16MB

# The CH343 bridge enumerates as a CDC device.  That makes the device name look
# like a native USB serial/JTAG part to rit, which would pick the wrong reset
# sequence, so the classic DTR/RTS one is selected explicitly here.
LT_FLASH_DEVICE                         ?= /dev/ttyACM0
LT_FLASH_NATIVE_USB                     := no

# rit auto-detects a part by reading its chip-ID register, but on the esp32p4
# that address is the flash cache window rather than ROM: the read goes
# unanswered and leaves the download loader unresponsive until the next reset.
# Name the chip instead so rit never reads it.
LT_FLASH_CHIP                           := esp32p4

# The ISA string the whole build is compiled and linked against.  The esp32p4 is
# RV32IMAFC with a single precision FPU; the project files that drive the linker
# directly (Esp32_MasterFirmwareImage.mk, Esp32_LTBootloader.mk) have to pass
# this to gcc on the link line too, or the link fails on an ABI mismatch against
# libgcc.  The z extensions upstream names (_zicsr_zifencei) are rejected by this
# toolchain's gcc 11.2 and are deliberately left off - the instructions they
# describe are accepted regardless at this -march.
SOC_CPU_ARCH_FLAGS                      := -march=rv32imafc -mabi=ilp32f

LT_CFLAGS_DEBUG                         += -gdwarf-3

# -mlongcalls and -fno-jump-tables, which the Xtensa variants carry, are Xtensa
# only options and are deliberately absent here.
LT_CFLAGS_GENERIC                       += $(SOC_CPU_ARCH_FLAGS)
LT_CFLAGS_GENERIC                       += -ffreestanding -fdiagnostics-color=auto -Wno-undef
LT_CFLAGS_GENERIC                       += -DLT_TEXT_RAM_CRITICAL_THRESHOLD=0 -DLT_RODATA_RAM_CRITICAL_THRESHOLD=0

LT_CXXFLAGS_GENERIC                     += $(SOC_CPU_ARCH_FLAGS)
LT_CXXFLAGS_GENERIC                     += -ffreestanding -fdiagnostics-color=auto -Wno-undef
LT_CXXFLAGS_GENERIC                     += -DLT_TEXT_RAM_CRITICAL_THRESHOLD=0 -DLT_RODATA_RAM_CRITICAL_THRESHOLD=0

######
# step 2 - setup toolchain variables
# TOOLCHAIN IDENTIFICATION
# a. Identifying the location:
#    Either:
#      LT_GCC_TOOLCHAIN_PATH    - the absolute path to the bin directory for the toolchain binaries
#    Or:
#      LT_TOOLCHAIN_SERVER      - <gitlab | github> - the server type from which to fetch the toolchain tarball
#      LT_TOOLCHAIN_REPO        - the repo from which to fetch the toolchain tarball
#      LT_TOOLCHAIN_TARFILE     - the name of the toolchain tarball file to fetch from the repo
#      LT_TOOLCHAIN_DIRNAME     - the name of the top level directory extracted from the toolchain tarball, e.g. if riscv64-bl70x-elf, toolchain bin dir would be: riscv64-bl70x-elf/bin
#                               - note: if LT_TOOLCHAIN_DIRNAME not specified, taken from basename of LT_TOOLCHAIN_TARFILE
# b. Identifying the prefix:
#      LT_GCC_TOOLCHAIN_PREFIX  - the prefix of toolchain binaries, e.g. "riscv64-unknown-elf" for riscv64-unknown-elf-gcc, riscv64-unknown-elf-nm, etc.
#
# The same riscv32-esp-elf the c3 uses - it is a multilib toolchain and already
# carries the rv32imafc/ilp32f variant this part links against.
#
# The fetch URL in the master makefile is fixed as
#   https://github.com/$(LT_TOOLCHAIN_REPO)/raw/refs/heads/main/$(LT_TOOLCHAIN_TARFILE)
# and Espressif publish the toolchain as a release asset, not as a file in a
# branch.  The leading ../ in LT_TOOLCHAIN_TARFILE below unwinds the
# "raw/refs/heads/main/" the makefile prepends, leaving the real releases/download
# URL after the client normalizes the path.  It looks odd on purpose - do not
# "tidy" the dot segments away without also changing the master makefile.
# $(notdir) in the fetch and extract steps still yields the plain tarball name,
# which is what curl -O writes and what tar then unpacks.
LT_TOOLCHAIN_SERVER         := github
LT_TOOLCHAIN_REPO           := espressif/crosstool-NG

ifeq ($(LT_TOOLCHAIN_HOST_OS_NAME), Darwin)
    # MAC
    ifeq ($(LT_TOOLCHAIN_HOST_ARCHITECTURE), arm64)
        LT_TOOLCHAIN_TARFILE ?= ../../../../releases/download/esp-2022r1/riscv32-esp-elf-gcc11_2_0-esp-2022r1-macos-arm64.tar.xz
    else
        LT_TOOLCHAIN_TARFILE ?= ../../../../releases/download/esp-2022r1/riscv32-esp-elf-gcc11_2_0-esp-2022r1-macos.tar.xz
    endif
else
    # NOT MAC
    ifeq ($(LT_TOOLCHAIN_HOST_ARCHITECTURE), x86_64)
        LT_TOOLCHAIN_TARFILE ?= ../../../../releases/download/esp-2022r1/riscv32-esp-elf-gcc11_2_0-esp-2022r1-linux-amd64.tar.xz
    endif
    ifeq ($(LT_TOOLCHAIN_HOST_ARCHITECTURE), aarch64)
        LT_TOOLCHAIN_TARFILE ?= ../../../../releases/download/esp-2022r1/riscv32-esp-elf-gcc11_2_0-esp-2022r1-linux-arm64.tar.xz
    endif
    LT_TOOLCHAIN_TARFILE ?= ../../../../releases/download/esp-2022r1/riscv32-esp-elf-gcc11_2_0-esp-2022r1-linux-i686.tar.xz
endif

# Must be explicit: the default would be derived from the tarball basename, which
# carries the version and host suffixes the archive itself does not.
LT_TOOLCHAIN_DIRNAME        := riscv32-esp-elf

LT_GCC_TOOLCHAIN_PREFIX     := riscv32-esp-elf

