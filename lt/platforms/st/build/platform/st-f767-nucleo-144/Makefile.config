ST_VENDOR_SDK_PATH      := thirdparty/vendor-sdk/stmicro/stm32-F767ZI-nucleo-144
ST_VENDOR_SDK_ROOT      := $(LT_PLATFORM_ROOT)/$(ST_VENDOR_SDK_PATH)
ST_VENDOR_SDK_LD_SCRIPT := $(ST_VENDOR_SDK_ROOT)/STM32F767ZITx_FLASH.ld

######
# step 0 - specify the LT_LTKERNEL_ARCHITECTURE for this platform
LT_LTKERNEL_ARCHITECTURE := LT_LTKERNEL_ARCHITECTURE_ARM_CORTEX_V7M

######
# step 1 - set LT_PLATFORM_HAS_RUNTIME_DYNAMIC_LOADER to yes or no
LT_PLATFORM_HAS_RUNTIME_DYNAMIC_LOADER := no

######
# step 2 - setup toolchain variables
# TOOLCHAIN IDENTIFICATION
# a. Identifying the location:
#    Either:
#      LT_GCC_TOOLCHAIN_PATH    - the absolute path to the bin directory for the toolchain binaries
#    Or:
#      LT_TOOLCHAIN_SERVER      - <gitlab | github> - the server type from which to fetch the toolchain tarball
#      LT_TOOLCHAIN_REPO        - the repo from which to fetch the toolchain tarball
#      LT_TOOLCHAIN_TARFILE     - the name of the toolchain tarball file to fetch from the repo
#      LT_TOOLCHAIN_DIRNAME     - the name of the top level directory extracted from the toolchain tarball, e.g. if riscv64-bl70x-elf, toolchain bin dir would be: riscv64-bl70x-elf/bin
#                               - note: if LT_TOOLCHAIN_DIRNAME not specified, taken from basename of LT_TOOLCHAIN_TARFILE
# b. Identifying the prefix:
#      LT_GCC_TOOLCHAIN_PREFIX  - the prefix of toolchain binaries, e.g. "riscv64-unknown-elf" for riscv64-unknown-elf-gcc, riscv64-unknown-elf-nm, etc.
LT_TOOLCHAIN_SERVER         := github
LT_TOOLCHAIN_REPO           := rokudev/lt-toolchains
LT_TOOLCHAIN_TARFILE        := st-arm-none-eabi-gcc-7.3.1-20180622-x86_64.tgz
LT_GCC_TOOLCHAIN_PREFIX     := arm-none-eabi

######
# step 3 - add or subtract default toolchain flags/switches.  ----> No -D switches or -I switches allowed <------
#LT_DISABLE_STATS        := yes

# CPU
ST_CPU_FLAGS      := -mcpu=cortex-m7 -mthumb
ST_CPU_FLAGS      += -mfpu=fpv5-d16 -mfloat-abi=hard

LT_CFLAGS_GENERIC += $(ST_CPU_FLAGS)
LT_CFLAGS_GENERIC += -ffreestanding -fno-jump-tables
LT_CFLAGS_GENERIC += -Wno-write-strings -Wno-maybe-uninitialized

LT_CFLAGS_DEBUG        += -gdwarf-2

LT_LDFLAGS_MASTERING   := $(ST_CPU_FLAGS)
LT_LDFLAGS_MASTERING   += -T$(ST_VENDOR_SDK_LD_SCRIPT)

######
# step 4 - add optional LT_PLATFORM_PROJECT_ONLY_DEFS
#          LT_PLATFORM_PROJECT_ONLY_DEFS are used only for platform projects (LT_PLATFORM_LTCOREBSP_PROJECT, LT_PLATFORM_DRIVER_PROJECTS and LT_PLATFORM_MASTERING_PROJECTS)
#          They are NOT added to OS projects or PRODUCT projects.
LT_PLATFORM_PROJECT_ONLY_DEFS := -DUSE_HAL_DRIVER
LT_PLATFORM_PROJECT_ONLY_DEFS += -DSTM32F767xx
LT_PLATFORM_PROJECT_ONLY_DEFS += -DST_F767_NUCLEO_144

######
# step 5 - specify LT_PLATFORM_LTCOREBSP_PROJECT, LT_PLATFORM_DRIVER_PROJECTS, and optional LT_PLATFORM_MASTERING_PROJECTS
LT_PLATFORM_LTCOREBSP_PROJECT  := STLTCoreBSP

LT_PLATFORM_DRIVER_PROJECTS    :=

LT_PLATFORM_MASTERING_PROJECTS := STMasterFirmwareImage


